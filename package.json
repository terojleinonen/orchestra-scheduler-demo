{
  "name": "orchestra-scheduler-demo",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "build": "npm run build --workspace server && npm run build --workspace client",
    "server": "npm run dev --workspace server",
    "client": "npm run dev --workspace client",
    "generate:xml": "tsx scripts/generateFakeOpasXml.ts"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "concurrently": "^9.1.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
