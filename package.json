{
  "name": "orchestra-scheduler-demo",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "build": "npm run build --workspace shared && npm run build --workspace server && npm run build --workspace client",
    "server": "npm run dev --workspace server",
    "client": "npm run dev --workspace client"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.4.0",
    "@types/react-window": "^1.8.8",
    "@types/sax": "^1.2.7",
    "concurrently": "^9.1.2",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.5.3",
    "react-window": "^1.8.7",
    "sax": "^1.5.0"
  }
}
